[Unit]
Description=Ronda de obstaculos WRO - Team Los Cedros
# multi-user, no basic: hace falta que el USB haya enumerado la Pico
# (/dev/ttyACM0) y la camara antes de abrir el enlace.
After=multi-user.target
Conflicts=shutdown.target

[Service]
Type=oneshot
User=pi
Group=pi
Environment=PYTHONUNBUFFERED=1
# Margen para que terminen de aparecer los dispositivos USB.
ExecStartPre=/bin/sleep 10

# Hace EXACTAMENTE lo mismo que escribir a mano en la terminal:
#
#   cd ~/ronda_unificada_20260916 && python3 -u ronda_unificada.py
#
# Sin despachador, sin ronda_activa y sin scripts intermedios. Se usa un
# shell de login (-l) para que el entorno sea el mismo que tiene el
# usuario pi cuando lo lanza por SSH, y exec para que python3 sea el
# proceso principal de la unidad y systemd lo pueda parar directo.
WorkingDirectory=/home/pi/ronda_unificada_20260916
ExecStart=/bin/bash -lc 'cd /home/pi/ronda_unificada_20260916 && exec python3 -u ronda_unificada.py'

RemainAfterExit=yes

# SIN Restart. Una carrera se lanza una vez. Con Restart=always el robot
# volvia a salir del estacionamiento solo, una y otra vez.

# Sin limite de arranque: el servicio se pasa la mayor parte del tiempo
# esperando el boton, y el limite de 90 s que systemd le pone por defecto
# a los oneshot lo mataria antes de que nadie lo pulse.
TimeoutStartSec=0

# Parar a mano (systemctl stop) manda SIGTERM mientras espera el boton.
# Sin esto, cada parada quedaba registrada como "Failed with result
# signal" y ensuciaba el log justo donde hay que mirar deprisa.
SuccessExitStatus=SIGTERM

StandardOutput=append:/home/pi/logs/servicio.log
StandardError=append:/home/pi/logs/servicio.log

[Install]
WantedBy=multi-user.target
